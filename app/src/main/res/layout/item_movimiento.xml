<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/colorGlassWhite">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTipoMov"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="25dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/colorCyan">
            
            <ImageView
                android:id="@+id/imgTipoMov"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/inventario"
                app:tint="@color/white"/>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvNombreProdMov"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Producto"
                android:textColor="@color/colorRoyalBlue"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCodigoProdMov"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CODE: SKU123"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:alpha="0.7"/>

            <TextView
                android:id="@+id/tvFechaMov"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17/04/2026"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:alpha="0.5"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvCantidadMov"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+10"
            android:textColor="@color/colorCyan"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
